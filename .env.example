# Auth.js — required
AUTH_SECRET=your-secret-here
AUTH_URL=http://localhost:3000

# Generate secret: openssl rand -base64 32

# Google OAuth — https://console.cloud.google.com/
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend — optional, for contact form emails only
RESEND_API_KEY=
EMAIL_FROM=FitBeat <onboarding@resend.dev>
CONTACT_EMAIL=hello@fitbeat.studio

# Upstash Redis — required for sign-in/sign-up (connect via Vercel Storage → Upstash)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternate names when using Upstash Vercel integration directly:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
